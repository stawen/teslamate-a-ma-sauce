    {
      "id": 11,
      "type": "table",
      "title": "Liste des recharges — clique la date pour la courbe",
      "description": "« Km depuis » = km parcourus depuis la recharge précédente. Rendement = énergie entrée dans la batterie ÷ énergie tirée à la prise.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cp.id, floor(extract(epoch FROM cp.start_date) * 1000) AS start_ms, floor(extract(epoch FROM cp.end_date) * 1000) + 1000 AS end_ms,\n  cp.start_date AS \"Date\", COALESCE(g.name, CONCAT_WS(', ', COALESCE(a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), '')), COALESCE(a.city, a.neighbourhood))) AS \"Lieu\", (SELECT CASE WHEN bool_or(c.fast_charger_present) OR NULLIF(max(c.charger_phases), 0) IS NULL THEN 'DC' ELSE 'AC' END FROM charges c WHERE c.charging_process_id = cp.id) AS \"Type\",\n  cp.start_battery_level || ' → ' || cp.end_battery_level || ' %' AS \"Batterie\", cp.end_battery_level AS \"Fin\",\n  cp.charge_energy_added AS \"Ajouté\", greatest(cp.charge_energy_added, cp.charge_energy_used) AS \"Prise\", cp.charge_energy_added / nullif(greatest(cp.charge_energy_added, cp.charge_energy_used), 0) * 100 AS \"Rendement\",\n  cp.duration_min * 60 AS \"Durée\", cp.charge_energy_added / nullif(cp.duration_min, 0) * 60 AS \"Puiss. moy.\",\n  (SELECT max(charger_power) FROM charges WHERE charging_process_id = cp.id) AS \"Puiss. max\",\n  (cp.end_${preferred_range}_range_km - cp.start_${preferred_range}_range_km) / nullif(cp.duration_min, 0) * 60 AS \"Km/h\",\n  cp.cost AS \"Coût\", cp.cost / nullif(greatest(cp.charge_energy_added, cp.charge_energy_used), 0) AS \"€/kWh\", cp.outside_temp_avg AS \"Temp.\",\n  p.odometer - lag(p.odometer) OVER (ORDER BY cp.start_date) AS \"Km depuis\"\nFROM charging_processes cp LEFT JOIN addresses a ON a.id = cp.address_id LEFT JOIN geofences g ON g.id = cp.geofence_id\n  LEFT JOIN positions p ON p.id = cp.position_id WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date) AND cp.end_date IS NOT NULL AND cp.charge_energy_added > 0\n    AND COALESCE(cp.duration_min, 0) >= COALESCE(NULLIF(regexp_replace(replace(${min_min:sqlstring}, ',', '.'), '[^0-9.]', '', 'g'), '')::numeric, 0) AND (SELECT CASE WHEN bool_or(c.fast_charger_present) OR NULLIF(max(c.charger_phases), 0) IS NULL THEN 'DC' ELSE 'AC' END FROM charges c WHERE c.charging_process_id = cp.id) IN (${type:sqlstring})\n    AND (${lieu:sqlstring} = '' OR COALESCE(g.name, CONCAT_WS(', ', COALESCE(a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), '')), COALESCE(a.city, a.neighbourhood))) ILIKE '%' || ${lieu:sqlstring} || '%') ORDER BY cp.start_date DESC",
          "refId": "A"
        }
      ],
