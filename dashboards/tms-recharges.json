    {
      "id": 3,
      "type": "stat",
      "title": "Recharges",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Recharges\", sum(cp.charge_energy_added) AS \"Ajouté\", sum(greatest(cp.charge_energy_added, cp.charge_energy_used)) AS \"À la prise\",\n  sum(cp.charge_energy_added) / nullif(sum(greatest(cp.charge_energy_added, cp.charge_energy_used)), 0) * 100 AS \"Rendement\", sum(cp.cost) AS \"Coût\",\n  sum(cp.cost) / nullif(sum(greatest(cp.charge_energy_added, cp.charge_energy_used)) FILTER (WHERE cp.cost IS NOT NULL), 0) AS \"Prix kWh\",\n  sum(cp.duration_min) * 60 AS \"Durée\", sum(cp.end_${preferred_range}_range_km - cp.start_${preferred_range}_range_km) AS \"Autonomie\"\nFROM charging_processes cp LEFT JOIN addresses a ON a.id = cp.address_id LEFT JOIN geofences g ON g.id = cp.geofence_id\n  LEFT JOIN positions p ON p.id = cp.position_id WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date) AND cp.end_date IS NOT NULL AND cp.charge_energy_added > 0\n    AND COALESCE(cp.duration_min, 0) >= COALESCE(NULLIF(regexp_replace(replace(${min_min:sqlstring}, ',', '.'), '[^0-9.]', '', 'g'), '')::numeric, 0) AND (SELECT CASE WHEN bool_or(c.fast_charger_present) OR NULLIF(max(c.charger_phases), 0) IS NULL THEN 'DC' ELSE 'AC' END FROM charges c WHERE c.charging_process_id = cp.id) IN (${type:sqlstring})\n    AND (${lieu:sqlstring} = '' OR COALESCE(g.name, CONCAT_WS(', ', COALESCE(a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), '')), COALESCE(a.city, a.neighbourhood))) ILIKE '%' || ${lieu:sqlstring} || '%')",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Recharges$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
