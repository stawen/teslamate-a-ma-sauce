    {
      "id": 14,
      "type": "table",
      "title": "Recharges non clôturées",
      "description": "Recharges que TeslaMate n'a pas pu terminer. Normalement vide.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cp.id AS \"N°\", cp.start_date AS \"Début\", cp.start_battery_level AS \"Batterie au début\",\n  (SELECT max(charge_energy_added) FROM charges WHERE charging_process_id = cp.id) AS \"Énergie\"\nFROM charging_processes cp WHERE cp.car_id = $car_id AND cp.end_date IS NULL ORDER BY cp.start_date DESC",
          "refId": "A"
        }
      ],
