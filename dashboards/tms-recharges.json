          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('week', timezone('UTC', cp.start_date), '$__timezone') AS time,\n  sum(cp.charge_energy_added) FILTER (WHERE (SELECT CASE WHEN bool_or(c.fast_charger_present) OR NULLIF(max(c.charger_phases), 0) IS NULL THEN 'DC' ELSE 'AC' END FROM charges c WHERE c.charging_process_id = cp.id) = 'AC') AS \"AC\", sum(cp.charge_energy_added) FILTER (WHERE (SELECT CASE WHEN bool_or(c.fast_charger_present) OR NULLIF(max(c.charger_phases), 0) IS NULL THEN 'DC' ELSE 'AC' END FROM charges c WHERE c.charging_process_id = cp.id) = 'DC') AS \"DC\"\nFROM charging_processes cp LEFT JOIN addresses a ON a.id = cp.address_id LEFT JOIN geofences g ON g.id = cp.geofence_id\n  LEFT JOIN positions p ON p.id = cp.position_id WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date) AND cp.end_date IS NOT NULL AND cp.charge_energy_added > 0\n    AND COALESCE(cp.duration_min, 0) >= COALESCE(NULLIF(regexp_replace(replace(${min_min:sqlstring}, ',', '.'), '[^0-9.]', '', 'g'), '')::numeric, 0) AND (SELECT CASE WHEN bool_or(c.fast_charger_present) OR NULLIF(max(c.charger_phases), 0) IS NULL THEN 'DC' ELSE 'AC' END FROM charges c WHERE c.charging_process_id = cp.id) IN (${type:sqlstring})\n    AND (${lieu:sqlstring} = '' OR COALESCE(g.name, CONCAT_WS(', ', COALESCE(a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), '')), COALESCE(a.city, a.neighbourhood))) ILIKE '%' || ${lieu:sqlstring} || '%') GROUP BY 1 ORDER BY 1",
          "refId": "A"
