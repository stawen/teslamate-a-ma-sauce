          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', timezone('UTC', d.start_date), '$__timezone') AS time, sum(d.distance) AS \"Distance\",\n  sum((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency) * 100 / nullif(sum(d.distance), 0) AS \"Conso\"\nFROM drives d JOIN cars car ON car.id = d.car_id\n  LEFT JOIN addresses sa ON sa.id = d.start_address_id LEFT JOIN addresses ea ON ea.id = d.end_address_id\n  LEFT JOIN geofences sg ON sg.id = d.start_geofence_id LEFT JOIN geofences eg ON eg.id = d.end_geofence_id\n  LEFT JOIN positions sp ON sp.id = d.start_position_id LEFT JOIN positions ep ON ep.id = d.end_position_id WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL AND COALESCE(d.distance, 0) >= COALESCE(NULLIF(regexp_replace(replace(${min_km:sqlstring}, ',', '.'), '[^0-9.]', '', 'g'), '')::numeric, 0)\n    AND (${lieu:sqlstring} = '' OR COALESCE(sg.name, CONCAT_WS(', ', COALESCE(sa.name, NULLIF(CONCAT_WS(' ', sa.road, sa.house_number), '')), COALESCE(sa.city, sa.neighbourhood))) ILIKE '%' || ${lieu:sqlstring} || '%' OR COALESCE(eg.name, CONCAT_WS(', ', COALESCE(ea.name, NULLIF(CONCAT_WS(' ', ea.road, ea.house_number), '')), COALESCE(ea.city, ea.neighbourhood))) ILIKE '%' || ${lieu:sqlstring} || '%') GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
