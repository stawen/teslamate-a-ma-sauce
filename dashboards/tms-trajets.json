    {
      "id": 11,
      "type": "table",
      "title": "Liste des trajets — clique la date pour le détail",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT d.id, floor(extract(epoch FROM d.start_date) * 1000) AS start_ms, floor(extract(epoch FROM d.end_date) * 1000) + 1000 AS end_ms,\n  d.start_date AS \"Date\", COALESCE(sg.name, CONCAT_WS(', ', COALESCE(sa.name, NULLIF(CONCAT_WS(' ', sa.road, sa.house_number), '')), COALESCE(sa.city, sa.neighbourhood))) AS \"Départ\", COALESCE(eg.name, CONCAT_WS(', ', COALESCE(ea.name, NULLIF(CONCAT_WS(' ', ea.road, ea.house_number), '')), COALESCE(ea.city, ea.neighbourhood))) AS \"Arrivée\",\n  d.duration_min * 60 AS \"Durée\", d.distance AS \"Distance\",\n  sp.battery_level || ' → ' || ep.battery_level || ' %' AS \"Batterie\",\n  (d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency AS \"Énergie\",\n  (d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency * 100 / nullif(d.distance, 0) AS \"Conso\",\n  d.distance / nullif(d.duration_min, 0) * 60 AS \"Vit. moy.\", d.speed_max AS \"Vit. max\", d.outside_temp_avg AS \"Temp. ext.\",\n  d.ascent AS \"Montée\"\nFROM drives d JOIN cars car ON car.id = d.car_id\n  LEFT JOIN addresses sa ON sa.id = d.start_address_id LEFT JOIN addresses ea ON ea.id = d.end_address_id\n  LEFT JOIN geofences sg ON sg.id = d.start_geofence_id LEFT JOIN geofences eg ON eg.id = d.end_geofence_id\n  LEFT JOIN positions sp ON sp.id = d.start_position_id LEFT JOIN positions ep ON ep.id = d.end_position_id WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL AND COALESCE(d.distance, 0) >= COALESCE(NULLIF(regexp_replace(replace(${min_km:sqlstring}, ',', '.'), '[^0-9.]', '', 'g'), '')::numeric, 0)\n    AND (${lieu:sqlstring} = '' OR COALESCE(sg.name, CONCAT_WS(', ', COALESCE(sa.name, NULLIF(CONCAT_WS(' ', sa.road, sa.house_number), '')), COALESCE(sa.city, sa.neighbourhood))) ILIKE '%' || ${lieu:sqlstring} || '%' OR COALESCE(eg.name, CONCAT_WS(', ', COALESCE(ea.name, NULLIF(CONCAT_WS(' ', ea.road, ea.house_number), '')), COALESCE(ea.city, ea.neighbourhood))) ILIKE '%' || ${lieu:sqlstring} || '%') ORDER BY d.start_date DESC LIMIT 1000",
          "refId": "A"
        }
      ],
