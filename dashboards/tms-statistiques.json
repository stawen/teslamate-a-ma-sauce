        "mode": "html",
        "content": "<div style=\"display:flex;flex-wrap:wrap;align-items:center;justify-content:center\"><a href=\"/d/tms-accueil?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#5B6E8C33;border:1px solid #5B6E8C;\">🏠&nbsp;Accueil</a><a href=\"/d/tms-vue?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#5B6E8C33;border:1px solid #5B6E8C;\">📟&nbsp;Vue&nbsp;d'ensemble</a><a href=\"/d/tms-chronologie?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#5B6E8C33;border:1px solid #5B6E8C;\">🕒&nbsp;Chronologie</a><a href=\"/d/tms-etats?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#5B6E8C33;border:1px solid #5B6E8C;\">💤&nbsp;États</a><span style=\"width:10px\"></span><a href=\"/d/tms-trajets?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#3274D933;border:1px solid #3274D9;\">🚗&nbsp;Trajets</a><a href=\"/d/tms-stats-conduite?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#3274D933;border:1px solid #3274D9;\">📈&nbsp;Stats&nbsp;conduite</a><a href=\"/d/tms-voyage?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#3274D933;border:1px solid #3274D9;\">🧳&nbsp;Voyage</a><a href=\"/d/tms-kilometrage?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#3274D933;border:1px solid #3274D9;\">🛣️&nbsp;Kilométrage</a><a href=\"/d/tms-efficacite?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#3274D933;border:1px solid #3274D9;\">🍃&nbsp;Efficacité</a><span style=\"width:10px\"></span><a href=\"/d/tms-recharges?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#56A64B33;border:1px solid #56A64B;\">🔌&nbsp;Recharges</a><a href=\"/d/tms-stats-recharge?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#56A64B33;border:1px solid #56A64B;\">📊&nbsp;Stats&nbsp;recharge</a><a href=\"/d/tm-energie-reelle?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#56A64B33;border:1px solid #56A64B;\">⚡&nbsp;Énergie&nbsp;réelle</a><span style=\"width:10px\"></span><a href=\"/d/tms-batterie?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#A352CC33;border:1px solid #A352CC;\">🔋&nbsp;Santé&nbsp;batterie</a><a href=\"/d/tms-niveau?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#A352CC33;border:1px solid #A352CC;\">🎚️&nbsp;Niveau&nbsp;de&nbsp;charge</a><a href=\"/d/tms-autonomie?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#A352CC33;border:1px solid #A352CC;\">📏&nbsp;Autonomie</a><a href=\"/d/tms-pertes?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#A352CC33;border:1px solid #A352CC;\">🧛&nbsp;Pertes&nbsp;à&nbsp;l'arrêt</a><a href=\"/d/tms-temperatures?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#A352CC33;border:1px solid #A352CC;\">🌡️&nbsp;Températures</a><span style=\"width:10px\"></span><a href=\"/d/tms-lieux?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#1F9FAA33;border:1px solid #1F9FAA;\">📍&nbsp;Lieux</a><a href=\"/d/tms-visites?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#1F9FAA33;border:1px solid #1F9FAA;\">🗺️&nbsp;Visites</a><span style=\"width:10px\"></span><a href=\"/d/tms-statistiques?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#6E7580;border:1px solid #6E7580;font-weight:600;box-shadow:0 0 0 2px #6E758055;\">🗓️&nbsp;Statistiques</a><a href=\"/d/tms-mises-a-jour?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#6E758033;border:1px solid #6E7580;\">⬆️&nbsp;Mises&nbsp;à&nbsp;jour</a><a href=\"/d/tms-base?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#6E758033;border:1px solid #6E7580;\">🗄️&nbsp;Base&nbsp;de&nbsp;données</a></div>"
