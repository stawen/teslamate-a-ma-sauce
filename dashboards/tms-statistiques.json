    {
      "id": 3,
      "type": "table",
      "title": "Par période",
      "description": "« Conso à la prise » = kWh tirés au compteur ÷ km : sur un mois ou plus, c'est ta vraie conso facturée.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH dr AS (\n  SELECT date_trunc('$periode', timezone('UTC', d.start_date), '$__timezone') AS p, count(*) AS trajets, sum(d.distance) AS km, sum(d.duration_min) * 60 AS duree,\n         sum((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency) AS kwh_route, avg(d.outside_temp_avg) AS temp\n  FROM drives d JOIN cars car ON car.id = d.car_id WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL GROUP BY 1),\nch AS (\n  SELECT date_trunc('$periode', timezone('UTC', cp.start_date), '$__timezone') AS p, count(*) AS recharges, sum(cp.charge_energy_added) AS ajoute, sum(greatest(cp.charge_energy_added, cp.charge_energy_used)) AS prise, sum(cp.cost) AS cout\n  FROM charging_processes cp WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date) AND cp.end_date IS NOT NULL AND cp.charge_energy_added > 0 GROUP BY 1)\nSELECT extract(epoch FROM p) * 1000 AS from_ms, extract(epoch FROM p + ('1 ' || '$periode')::interval) * 1000 AS to_ms,\n  CASE '$periode' WHEN 'day' THEN to_char(timezone('$__timezone', p), 'DD/MM/YYYY')\n    WHEN 'week' THEN 'Semaine ' || to_char(timezone('$__timezone', p), 'IW') || ' – ' || to_char(timezone('$__timezone', p), 'DD/MM/YYYY')\n    WHEN 'month' THEN initcap((ARRAY['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'])[extract(month FROM timezone('$__timezone', p))::int]) || ' ' || to_char(timezone('$__timezone', p), 'YYYY')\n    ELSE to_char(timezone('$__timezone', p), 'YYYY') END AS \"Période\",\n  dr.trajets AS \"Trajets\", dr.km AS \"Km\", dr.duree AS \"Au volant\", dr.kwh_route * 100 / nullif(dr.km, 0) AS \"Conso roulage\",\n  ch.prise * 100 / nullif(dr.km, 0) AS \"Conso à la prise\", dr.temp AS \"Temp. moy.\", ch.recharges AS \"Recharges\", ch.ajoute AS \"kWh ajoutés\",\n  ch.prise AS \"kWh prise\", ch.cout AS \"Coût\", ch.cout * 100 / nullif(dr.km, 0) AS \"€ / 100 km\"\nFROM dr FULL JOIN ch USING (p) ORDER BY p DESC",
          "refId": "A"
        }
      ],
