          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH dr AS (\n  SELECT date_trunc('$periode', timezone('UTC', d.start_date), '$__timezone') AS p, count(*) AS trajets, sum(d.distance) AS km, sum(d.duration_min) * 60 AS duree,\n         sum((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency) AS kwh_route, avg(d.outside_temp_avg) AS temp\n  FROM drives d JOIN cars car ON car.id = d.car_id WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL GROUP BY 1),\nch AS (\n  SELECT date_trunc('$periode', timezone('UTC', cp.start_date), '$__timezone') AS p, count(*) AS recharges, sum(cp.charge_energy_added) AS ajoute, sum(greatest(cp.charge_energy_added, cp.charge_energy_used)) AS prise, sum(cp.cost) AS cout\n  FROM charging_processes cp WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date) AND cp.end_date IS NOT NULL AND cp.charge_energy_added > 0 GROUP BY 1)\nSELECT p AS time, dr.km AS \"Km\", ch.cout AS \"Coût\" FROM dr FULL JOIN ch USING (p) ORDER BY p",
