    {
      "id": 14,
      "type": "barchart",
      "title": "Temps passé par vitesse",
      "description": "Part du temps de conduite passé dans chaque tranche de 10 km/h.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH p AS (SELECT drive_id, floor(speed / 10) AS b, count(*) AS n FROM positions\n           WHERE car_id = $car_id AND drive_id IS NOT NULL AND $__timeFilter(date) AND speed > 0 GROUP BY 1, 2),\nw AS (SELECT p.b, p.n::float / sum(p.n) OVER (PARTITION BY p.drive_id) * d.duration_min AS m FROM p JOIN drives d ON d.id = p.drive_id)\nSELECT (b * 10)::int || '' AS \"Vitesse (km/h)\", sum(m) * 100 / sum(sum(m)) OVER () AS \"Part du temps\"\nFROM w GROUP BY b ORDER BY b",
          "refId": "A"
        }
      ],
      "options": {
        "xField": "Vitesse (km/h)",
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 85,
            "gradientMode": "none",
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Part du temps"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3274D9"
                }
              }
            ]
          }
        ]
      }
    },
    {
