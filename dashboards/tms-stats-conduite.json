    {
      "id": 3,
      "type": "stat",
      "title": "Trajets",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Trajets\", sum(d.distance) AS \"Distance\", sum((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency) AS \"Énergie\",\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY d.distance) AS \"Trajet médian\", sum(d.distance) / GREATEST(extract(epoch FROM LEAST($__timeTo()::timestamp, now() AT TIME ZONE 'UTC') - GREATEST($__timeFrom()::timestamp, (SELECT min(start_date) FROM drives WHERE car_id = $car_id))) / 86400, 1) AS \"Km par jour\",\n  sum((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency) / GREATEST(extract(epoch FROM LEAST($__timeTo()::timestamp, now() AT TIME ZONE 'UTC') - GREATEST($__timeFrom()::timestamp, (SELECT min(start_date) FROM drives WHERE car_id = $car_id))) / 86400, 1) AS \"kWh par jour\", max(d.speed_max) AS \"Vitesse max\",\n  sum(d.duration_min) * 60 AS \"Durée\", sum(d.distance) / GREATEST(extract(epoch FROM LEAST($__timeTo()::timestamp, now() AT TIME ZONE 'UTC') - GREATEST($__timeFrom()::timestamp, (SELECT min(start_date) FROM drives WHERE car_id = $car_id))) / 86400, 1) * 30.44 AS \"Projection mois\", sum(d.distance) / GREATEST(extract(epoch FROM LEAST($__timeTo()::timestamp, now() AT TIME ZONE 'UTC') - GREATEST($__timeFrom()::timestamp, (SELECT min(start_date) FROM drives WHERE car_id = $car_id))) / 86400, 1) * 365 AS \"Projection an\",\n  sum((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency) * 100 / nullif(sum(d.distance), 0) AS \"Conso\"\nFROM drives d JOIN cars car ON car.id = d.car_id\nWHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Trajets$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3274D9",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
