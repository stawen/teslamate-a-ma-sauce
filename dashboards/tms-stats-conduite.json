          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lpad(h::text, 2, '0') || 'h' AS \"Heure\", COALESCE(n, 0) AS \"Trajets\", COALESCE(km, 0) AS \"Km\"\nFROM generate_series(0, 23) h LEFT JOIN (\n  SELECT extract(hour FROM timezone('$__timezone', timezone('UTC', start_date)))::int AS hh, count(*) AS n, sum(distance) AS km\n  FROM drives WHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL GROUP BY 1) x ON x.hh = h ORDER BY h",
          "refId": "A"
        }
      ],
