    {
      "id": 3,
      "type": "stat",
      "title": "Adresses",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH visits AS (\n  SELECT d.end_address_id AS address_id, d.end_geofence_id AS geofence_id, d.end_date AS ts,\n         lead(d.start_date) OVER (ORDER BY d.start_date) AS until_ts\n  FROM drives d WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL\n  UNION ALL\n  SELECT d.start_address_id, d.start_geofence_id, d.start_date, NULL FROM drives d\n  WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL\n  UNION ALL\n  SELECT cp.address_id, cp.geofence_id, cp.start_date, NULL FROM charging_processes cp\n  WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date))\nSELECT count(DISTINCT v.address_id) AS \"Adresses\", count(DISTINCT a.city) AS \"Villes\", count(DISTINCT a.state) AS \"Régions\",\n  count(DISTINCT a.country) AS \"Pays\", count(DISTINCT v.geofence_id) AS \"Lieux enregistrés\"\nFROM visits v JOIN addresses a ON a.id = v.address_id LEFT JOIN geofences g ON g.id = v.geofence_id WHERE (${filtre:sqlstring} = '' OR a.display_name ILIKE '%' || ${filtre:sqlstring} || '%' OR g.name ILIKE '%' || ${filtre:sqlstring} || '%')",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Adresses$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1F9FAA",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
