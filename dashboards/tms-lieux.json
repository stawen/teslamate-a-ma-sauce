          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH visits AS (\n  SELECT d.end_address_id AS address_id, d.end_geofence_id AS geofence_id, d.end_date AS ts,\n         lead(d.start_date) OVER (ORDER BY d.start_date) AS until_ts\n  FROM drives d WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL\n  UNION ALL\n  SELECT d.start_address_id, d.start_geofence_id, d.start_date, NULL FROM drives d\n  WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL\n  UNION ALL\n  SELECT cp.address_id, cp.geofence_id, cp.start_date, NULL FROM charging_processes cp\n  WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date))\nSELECT COALESCE(g.name, CONCAT_WS(', ', COALESCE(a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), '')), COALESCE(a.city, a.neighbourhood))) AS \"Lieu\", a.latitude::float AS latitude, a.longitude::float AS longitude, count(*) AS \"Visites\"\nFROM visits v JOIN addresses a ON a.id = v.address_id LEFT JOIN geofences g ON g.id = v.geofence_id WHERE (${filtre:sqlstring} = '' OR a.display_name ILIKE '%' || ${filtre:sqlstring} || '%' OR g.name ILIKE '%' || ${filtre:sqlstring} || '%') GROUP BY 1, 2, 3",
          "refId": "A"
        }
