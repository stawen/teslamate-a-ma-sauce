    {
      "id": 19,
      "type": "trend",
      "title": "Capacité selon le kilométrage",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH est AS (\n  SELECT cp.end_date AS date, p.odometer AS odo, lc.r * car.efficiency / nullif(lc.u, 0) * 100 AS kwh\n  FROM charging_processes cp JOIN cars car ON car.id = cp.car_id\n  JOIN LATERAL (SELECT c.rated_battery_range_km AS r, c.usable_battery_level AS u FROM charges c\n                WHERE c.charging_process_id = cp.id AND c.usable_battery_level > 0 AND c.rated_battery_range_km IS NOT NULL\n                ORDER BY c.date DESC LIMIT 1) lc ON true\n  LEFT JOIN positions p ON p.id = cp.position_id\n  WHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL AND cp.charge_energy_added >= 5)\nSELECT odo AS \"Odomètre\", kwh::float AS \"Recharge\", NULL::float AS \"Médiane du mois\" FROM est WHERE odo IS NOT NULL\nUNION ALL SELECT min(odo), NULL, percentile_cont(0.5) WITHIN GROUP (ORDER BY kwh) FROM est WHERE odo IS NOT NULL GROUP BY date_trunc('month', date)\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "xField": "Odomètre",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Odomètre"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: km"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Recharge"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#A352CC88"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Médiane du mois"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#A352CC"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 20,
      "type": "piechart",
      "title": "Énergie AC / DC (depuis le début)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT CASE WHEN bool_or(c.fast_charger_present) OR NULLIF(max(c.charger_phases), 0) IS NULL THEN 'DC' ELSE 'AC' END FROM charges c WHERE c.charging_process_id = cp.id) AS metric, sum(greatest(cp.charge_energy_added, cp.charge_energy_used)) AS value FROM charging_processes cp\nWHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL AND cp.charge_energy_added > 0 GROUP BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "AC"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#56A64B"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DC"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E0752D"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 21,
