    {
      "id": 3,
      "type": "gauge",
      "title": "Santé",
      "description": "Capacité actuelle ÷ capacité neuve. « Neuve » = meilleure médiane mensuelle observée, sauf si tu la saisis en haut.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH est AS (\n  SELECT cp.end_date AS date, p.odometer AS odo, lc.r * car.efficiency / nullif(lc.u, 0) * 100 AS kwh\n  FROM charging_processes cp JOIN cars car ON car.id = cp.car_id\n  JOIN LATERAL (SELECT c.rated_battery_range_km AS r, c.usable_battery_level AS u FROM charges c\n                WHERE c.charging_process_id = cp.id AND c.usable_battery_level > 0 AND c.rated_battery_range_km IS NOT NULL\n                ORDER BY c.date DESC LIMIT 1) lc ON true\n  LEFT JOIN positions p ON p.id = cp.position_id\n  WHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL AND cp.charge_energy_added >= 5),\nmonthly AS (SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY kwh) AS m FROM est GROUP BY date_trunc('month', date) HAVING count(*) >= 3),\ncur AS (SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY kwh) AS k FROM (SELECT kwh FROM est ORDER BY date DESC LIMIT 10) x),\ninput AS (SELECT COALESCE(NULLIF(regexp_replace(replace(${kwh_neuf:sqlstring}, ',', '.'), '[^0-9.]', '', 'g'), '')::numeric, 0) AS k),\nref AS (SELECT CASE WHEN input.k > 0 THEN input.k ELSE (SELECT max(m) FROM monthly) END AS k FROM input),\nstats AS (SELECT count(*) AS n, sum(charge_energy_added) AS added, sum(greatest(cp.charge_energy_added, cp.charge_energy_used)) AS wall FROM charging_processes cp\n          WHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL AND cp.charge_energy_added > 0),\ndr AS (SELECT sum(distance) AS logged, max(end_km) AS odo FROM drives WHERE car_id = $car_id)\nSELECT CASE WHEN cur.k IS NOT NULL AND ref.k > 0 THEN LEAST(cur.k / ref.k * 100, 100) END AS \"Santé\", ref.k AS \"Neuve\", cur.k AS \"Actuelle\", cur.k - ref.k AS \"Écart\",\n  CASE WHEN cur.k IS NOT NULL AND ref.k > 0 THEN GREATEST(100 - cur.k / ref.k * 100, 0) END AS \"Dégradation\",\n  ref.k / (SELECT efficiency FROM cars WHERE id = $car_id) AS \"Autonomie neuve\", cur.k / (SELECT efficiency FROM cars WHERE id = $car_id) AS \"Autonomie actuelle\",\n  stats.n AS \"Recharges\", stats.added / nullif(ref.k, 0) AS \"Cycles\", stats.added AS \"Ajouté\", stats.wall AS \"Prise\",\n  stats.added / nullif(stats.wall, 0) * 100 AS \"Rendement\", dr.logged AS \"Enregistrés\", dr.odo AS \"Odomètre\",\n  (SELECT battery_level FROM positions WHERE car_id = $car_id AND ideal_battery_range_km IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Niveau\",\n  (SELECT battery_level FROM positions WHERE car_id = $car_id AND ideal_battery_range_km IS NOT NULL ORDER BY date DESC LIMIT 1) * cur.k / 100 AS \"Stockée\"\nFROM cur, ref, stats, dr",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Santé$/",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "minVizHeight": 75,
        "minVizWidth": 75,
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 50,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C4162A",
                "value": null
              },
              {
                "color": "#E0752D",
                "value": 70
              },
              {
                "color": "#E0B400",
                "value": 80
              },
              {
                "color": "#56A64B",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
