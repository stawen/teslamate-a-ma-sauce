      "options": {
        "mode": "html",
        "content": "<div style=\"background-color:#7B2FA8;border-radius:8px;padding:9px 18px;color:#fff;font-size:14px;box-shadow:0 2px 6px rgba(0,0,0,0.25);\"><b style=\"font-size:16px;letter-spacing:0.3px;\">🔋 CAPACITÉ UTILE</b><span style=\"color:rgba(255,255,255,0.88);\">&nbsp;&nbsp;—&nbsp;&nbsp;estimée à chaque recharge : autonomie affichée × consommation de référence ÷ niveau de batterie</span></div>"
      }
