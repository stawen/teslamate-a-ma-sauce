                  "fixedColor": "#A352CC"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
