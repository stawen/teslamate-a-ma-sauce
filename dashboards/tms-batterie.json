          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH est AS (\n  SELECT cp.end_date AS date, p.odometer AS odo, lc.r * car.efficiency / nullif(lc.u, 0) * 100 AS kwh\n  FROM charging_processes cp JOIN cars car ON car.id = cp.car_id\n  JOIN LATERAL (SELECT c.rated_battery_range_km AS r, c.usable_battery_level AS u FROM charges c\n                WHERE c.charging_process_id = cp.id AND c.usable_battery_level > 0 AND c.rated_battery_range_km IS NOT NULL\n                ORDER BY c.date DESC LIMIT 1) lc ON true\n  LEFT JOIN positions p ON p.id = cp.position_id\n  WHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL AND cp.charge_energy_added >= 5) SELECT date AS time, kwh AS \"Capacité\" FROM est WHERE $__timeFilter(date) ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
