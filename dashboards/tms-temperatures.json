    {
      "id": 11,
      "type": "timeseries",
      "title": "Clim / chauffage voiture garée (heures par jour)",
      "description": "Préconditionnement, mode chien/camping, protection surchauffe… Chaque heure coûte plusieurs kWh.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 14,
        "y": 18,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT date, drive_id, is_climate_on, lead(date) OVER (ORDER BY date) AS next_date\n           FROM positions WHERE car_id = $car_id AND $__timeFilter(date)),\nintervals AS (SELECT date, is_climate_on, CASE WHEN next_date IS NOT NULL THEN LEAST(extract(epoch FROM next_date - date), 900) END AS dt\n              FROM s WHERE drive_id IS NULL)\nSELECT date_trunc('day', timezone('UTC', date), '$__timezone') AS time, sum(dt) FILTER (WHERE is_climate_on) / 3600 AS \"Heures\"\nFROM intervals GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "opacity",
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "axisLabel": "",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Heures"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E0752D"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
