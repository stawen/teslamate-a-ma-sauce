      "options": {
        "mode": "html",
        "content": "<div style=\"background-color:#1F60C4;border-radius:8px;padding:9px 18px;color:#fff;font-size:14px;box-shadow:0 2px 6px rgba(0,0,0,0.25);\"><b style=\"font-size:16px;letter-spacing:0.3px;\">🍃 CONSOMMATION</b><span style=\"color:rgba(255,255,255,0.88);\">&nbsp;&nbsp;—&nbsp;&nbsp;en kWh/100 km ; « roulage » = trajets seuls, « réelle » = tout ce qui est sorti de la batterie sur la période</span></div>"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Conso roulage",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS (\n  SELECT (SELECT ${preferred_range}_battery_range_km FROM positions WHERE car_id = $car_id AND $__timeFilter(date) AND ideal_battery_range_km IS NOT NULL AND ${preferred_range}_battery_range_km IS NOT NULL ORDER BY date LIMIT 1) AS r0,\n         (SELECT ${preferred_range}_battery_range_km FROM positions WHERE car_id = $car_id AND $__timeFilter(date) AND ideal_battery_range_km IS NOT NULL AND ${preferred_range}_battery_range_km IS NOT NULL ORDER BY date DESC LIMIT 1) AS r1,\n         (SELECT sum(end_${preferred_range}_range_km - start_${preferred_range}_range_km) FROM charging_processes WHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL) AS added,\n         (SELECT sum(distance) FROM drives WHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL) AS km)\nSELECT (SELECT sum((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency) * 100 / nullif(sum(d.distance), 0) FROM drives d JOIN cars car ON car.id = d.car_id\nWHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL AND d.distance >= $min_km\n  AND d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km > 0.1) AS \"Conso\",\n  (r.r0 + COALESCE(r.added, 0) - r.r1) * (SELECT efficiency FROM cars WHERE id = $car_id) * 100 / nullif(r.km, 0) AS \"Conso réelle\",\n  r.km AS \"Distance\", (SELECT efficiency * 100 FROM cars WHERE id = $car_id) AS \"Référence\",\n  (SELECT sum(d.distance) / nullif(sum(d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km), 0) * 100 FROM drives d JOIN cars car ON car.id = d.car_id\nWHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL AND d.distance >= $min_km\n  AND d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km > 0.1) AS \"Efficacité\"\nFROM r",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Conso$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kWh/100 km",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              },
              {
                "color": "#E0B400",
                "value": 15
              },
              {
                "color": "#E0752D",
                "value": 18
              },
              {
                "color": "#C4162A",
                "value": 22
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
