    {
      "id": 9,
      "type": "barchart",
      "title": "Selon la température extérieure",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (floor(d.outside_temp_avg / 5) * 5)::int || ' à ' || (floor(d.outside_temp_avg / 5) * 5 + 5)::int || ' °C' AS \"Température\",\n  sum((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency) * 100 / nullif(sum(d.distance), 0) AS \"Conso\", sum(d.distance) AS \"Distance\", sum(d.distance) / nullif(sum(d.duration_min), 0) * 60 AS \"Vitesse moy.\"\nFROM drives d JOIN cars car ON car.id = d.car_id\nWHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL AND d.distance >= $min_km\n  AND d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km > 0.1 AND d.outside_temp_avg IS NOT NULL GROUP BY floor(d.outside_temp_avg / 5) HAVING sum(d.distance) > 5 ORDER BY floor(d.outside_temp_avg / 5)",
          "refId": "A"
        }
