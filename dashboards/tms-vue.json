          "rawSql": "SELECT c.date AS time, c.charger_power AS \"Puissance\", CASE WHEN NOT c.fast_charger_present THEN c.charger_actual_current END AS \"Courant\",\n  c.charge_energy_added AS \"Énergie ajoutée\", (COALESCE(c.battery_heater_on, false) OR COALESCE(c.battery_heater, false))::int AS \"Chauffe batterie\"\nFROM charges c JOIN charging_processes cp ON cp.id = c.charging_process_id WHERE cp.car_id = $car_id AND $__timeFilter(c.date) ORDER BY 1",
