    {
      "id": 15,
      "type": "timeseries",
      "title": "Niveau de batterie",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 12,
