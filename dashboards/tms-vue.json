    {
      "id": 9,
      "type": "stat",
      "title": "Conso roulage",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH r AS (\n  SELECT (SELECT ${preferred_range}_battery_range_km FROM positions WHERE car_id = $car_id AND $__timeFilter(date) AND ideal_battery_range_km IS NOT NULL AND ${preferred_range}_battery_range_km IS NOT NULL ORDER BY date LIMIT 1) AS r0,\n         (SELECT ${preferred_range}_battery_range_km FROM positions WHERE car_id = $car_id AND $__timeFilter(date) AND ideal_battery_range_km IS NOT NULL AND ${preferred_range}_battery_range_km IS NOT NULL ORDER BY date DESC LIMIT 1) AS r1,\n         (SELECT sum(end_${preferred_range}_range_km - start_${preferred_range}_range_km) FROM charging_processes WHERE car_id = $car_id AND $__timeFilter(start_date) AND end_date IS NOT NULL) AS added)\nSELECT (SELECT sum((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency) * 100 / nullif(sum(d.distance), 0) FROM drives d JOIN cars car ON car.id = d.car_id WHERE d.car_id = $car_id AND $__timeFilter(d.start_date)) AS \"Conso\",\n  (SELECT sum(distance) FROM drives WHERE car_id = $car_id AND $__timeFilter(start_date)) AS \"Distance\",\n  (r.r0 + COALESCE(r.added, 0) - r.r1) * (SELECT efficiency FROM cars WHERE id = $car_id) AS \"Énergie\" FROM r",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Conso$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kWh/100 km",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              },
              {
                "color": "#E0B400",
                "value": 15
              },
              {
                "color": "#E0752D",
                "value": 18
              },
              {
                "color": "#C4162A",
                "value": 22
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
