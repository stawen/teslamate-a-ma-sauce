    {
      "id": 3,
      "type": "gauge",
      "title": "Batterie",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH lc AS (SELECT id, end_date FROM charging_processes WHERE car_id = $car_id ORDER BY start_date DESC LIMIT 1),\nc AS (SELECT c.* FROM charges c, lc WHERE c.charging_process_id = lc.id AND lc.end_date IS NULL ORDER BY c.date DESC LIMIT 1)\nSELECT (SELECT battery_level FROM positions WHERE car_id = $car_id AND ideal_battery_range_km IS NOT NULL AND battery_level IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Batterie\", (SELECT ${preferred_range}_battery_range_km FROM positions WHERE car_id = $car_id AND ideal_battery_range_km IS NOT NULL AND ${preferred_range}_battery_range_km IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Autonomie\",\n  COALESCE((SELECT charger_power FROM c), 0) AS \"Puissance\", (SELECT CASE WHEN NOT fast_charger_present THEN charger_voltage END FROM c) AS \"Tension\",\n  (SELECT odometer FROM positions WHERE car_id = $car_id AND ideal_battery_range_km IS NOT NULL AND odometer IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Odomètre\", (SELECT split_part(version, ' ', 1) FROM updates WHERE car_id = $car_id ORDER BY start_date DESC LIMIT 1) AS \"Version\",\n  (SELECT outside_temp FROM positions WHERE car_id = $car_id AND ideal_battery_range_km IS NOT NULL AND outside_temp IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Ext.\", (SELECT inside_temp FROM positions WHERE car_id = $car_id AND ideal_battery_range_km IS NOT NULL AND inside_temp IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Int.\", (SELECT driver_temp_setting FROM positions WHERE car_id = $car_id AND ideal_battery_range_km IS NOT NULL AND driver_temp_setting IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Consigne\"",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Batterie$/",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "minVizHeight": 75,
        "minVizWidth": 75,
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C4162A",
                "value": null
              },
              {
                "color": "#E0752D",
                "value": 20
              },
              {
                "color": "#56A64B",
                "value": 35
              },
              {
                "color": "#3274D9",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      }
    },
