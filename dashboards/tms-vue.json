    {
      "id": 17,
      "type": "state-timeline",
      "title": "Activité",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH ev AS (\n  SELECT start_date AS t, CASE state WHEN 'online' THEN 5 WHEN 'asleep' THEN 4 ELSE 3 END AS s FROM states WHERE car_id = $car_id AND start_date < $__timeTo()::timestamp AND COALESCE(end_date, now() AT TIME ZONE 'UTC') > $__timeFrom()::timestamp - interval '2 days'\n  UNION ALL SELECT unnest(ARRAY[start_date + interval '1 second', end_date]), unnest(ARRAY[1, 5]) FROM drives WHERE car_id = $car_id AND start_date < $__timeTo()::timestamp AND COALESCE(end_date, now() AT TIME ZONE 'UTC') > $__timeFrom()::timestamp - interval '2 days'\n  UNION ALL SELECT unnest(ARRAY[start_date + interval '1 second', end_date]), unnest(ARRAY[2, 5]) FROM charging_processes WHERE car_id = $car_id AND start_date < $__timeTo()::timestamp AND COALESCE(end_date, now() AT TIME ZONE 'UTC') > $__timeFrom()::timestamp - interval '2 days'\n  UNION ALL SELECT unnest(ARRAY[start_date + interval '1 second', end_date]), unnest(ARRAY[6, 5]) FROM updates WHERE car_id = $car_id AND start_date < $__timeTo()::timestamp AND COALESCE(end_date, now() AT TIME ZONE 'UTC') > $__timeFrom()::timestamp - interval '2 days'\n)\nSELECT t AS time, s AS \"État\" FROM ev WHERE t IS NOT NULL ORDER BY t, s",
          "refId": "A"
        }
      ],
      "options": {
        "alignValue": "center",
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
