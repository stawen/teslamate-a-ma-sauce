      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date AS time, battery_level AS \"Batterie\" FROM (\n  SELECT date, battery_level FROM positions WHERE car_id = $car_id AND $__timeFilter(date) AND ideal_battery_range_km IS NOT NULL\n  UNION ALL SELECT c.date, c.battery_level FROM charges c JOIN charging_processes cp ON cp.id = c.charging_process_id\n  WHERE cp.car_id = $car_id AND $__timeFilter(c.date)) x ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
