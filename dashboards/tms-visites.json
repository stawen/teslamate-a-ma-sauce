    {
      "id": 3,
      "type": "stat",
      "title": "Distance",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH visits AS (\n  SELECT d.end_address_id AS address_id, d.end_geofence_id AS geofence_id, d.end_date AS ts,\n         lead(d.start_date) OVER (ORDER BY d.start_date) AS until_ts\n  FROM drives d WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL\n  UNION ALL\n  SELECT d.start_address_id, d.start_geofence_id, d.start_date, NULL FROM drives d\n  WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL\n  UNION ALL\n  SELECT cp.address_id, cp.geofence_id, cp.start_date, NULL FROM charging_processes cp\n  WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date)),\npl AS (SELECT lower(NULLIF(a.raw #>> '{address,country_code}', '')) AS cc, a.country AS pays, COALESCE(a.city, a.neighbourhood) AS ville, COALESCE(NULLIF(a.state_district, ''), a.state) AS region,\n              a.latitude, a.longitude, v.ts, (timezone('$__timezone', timezone('UTC', v.ts)))::date AS jour\n       FROM visits v JOIN addresses a ON a.id = v.address_id WHERE a.country IS NOT NULL)\nSELECT (SELECT sum(distance) FROM drives WHERE car_id = $car_id AND $__timeFilter(start_date)) AS \"Distance\",\n  (SELECT sum(cost) FROM charging_processes WHERE car_id = $car_id AND $__timeFilter(start_date)) AS \"Coût\",\n  (SELECT sum(charge_energy_added) FROM charging_processes WHERE car_id = $car_id AND $__timeFilter(start_date)) AS \"Énergie\",\n  count(DISTINCT cc) AS \"Pays\", count(DISTINCT (cc, ville)) AS \"Villes\", count(DISTINCT jour) AS \"Jours\" FROM pl",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Distance$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: km",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1F9FAA",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
