ize:12px;text-decoration:none;color:#fff;background:#3274D9;border:1px solid #3274D9;font-weight:600;box-shadow:0 0 0 2px #3274D955;\">🛣️&nbsp;Kilométrage</a><a href=\"/d/tms-efficacite?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#3274D933;border:1px solid #3274D9;\">🍃&nbsp;Efficacité</a><span style=\"width:10px\"></span><a href=\"/d/tms-recharges?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#56A64B33;border:1px solid #56A64B;\">🔌&nbsp;Recharges</a><a href=\"/d/tms-stats-recharge?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#56A64B33;border:1px solid #56A64B;\">📊&nbsp;Stats&nbsp;recharge</a><a href=\"/d/tm-energie-reelle?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#56A64B33;border:1px solid #56A64B;\">⚡&nbsp;Énergie&nbsp;réelle</a><span style=\"width:10px\"></span><a href=\"/d/tms-batterie?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#A352CC33;border:1px solid #A352CC;\">🔋&nbsp;Santé&nbsp;batterie</a><a href=\"/d/tms-niveau?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#A352CC33;border:1px solid #A352CC;\">🎚️&nbsp;Niveau&nbsp;de&nbsp;charge</a><a href=\"/d/tms-autonomie?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#A352CC33;border:1px solid #A352CC;\">📏&nbsp;Autonomie<