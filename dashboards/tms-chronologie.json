    {
      "id": 3,
      "type": "stat",
      "title": "Conduite",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ev AS (\n  SELECT 'drive' AS k, d.id, d.start_date AS s, d.end_date AS e, COALESCE(sg.name, CONCAT_WS(', ', COALESCE(sa.name, NULLIF(CONCAT_WS(' ', sa.road, sa.house_number), '')), COALESCE(sa.city, sa.neighbourhood))) AS de, COALESCE(eg.name, CONCAT_WS(', ', COALESCE(ea.name, NULLIF(CONCAT_WS(' ', ea.road, ea.house_number), '')), COALESCE(ea.city, ea.neighbourhood))) AS vers,\n         sp.battery_level AS b0, ep.battery_level AS b1, d.distance AS km, (d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency AS kwh,\n         NULL::numeric AS cost, d.start_km AS o0, d.end_km AS o1, NULL AS typ\n  FROM drives d JOIN cars car ON car.id = d.car_id\n  LEFT JOIN addresses sa ON sa.id = d.start_address_id LEFT JOIN addresses ea ON ea.id = d.end_address_id\n  LEFT JOIN geofences sg ON sg.id = d.start_geofence_id LEFT JOIN geofences eg ON eg.id = d.end_geofence_id\n  LEFT JOIN positions sp ON sp.id = d.start_position_id LEFT JOIN positions ep ON ep.id = d.end_position_id WHERE d.car_id = $car_id AND d.start_date < $__timeTo()::timestamp AND COALESCE(d.end_date, now() AT TIME ZONE 'UTC') > $__timeFrom()::timestamp - interval '3 days'\n  UNION ALL\n  SELECT 'charge', cp.id, cp.start_date, cp.end_date, COALESCE(g.name, CONCAT_WS(', ', COALESCE(a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), '')), COALESCE(a.city, a.neighbourhood))), NULL, cp.start_battery_level, cp.end_battery_level, NULL, cp.charge_energy_added,\n         cp.cost, p.odometer, p.odometer, (SELECT CASE WHEN bool_or(c.fast_charger_present) OR NULLIF(max(c.charger_phases), 0) IS NULL THEN 'DC' ELSE 'AC' END FROM charges c WHERE c.charging_process_id = cp.id)\n  FROM charging_processes cp LEFT JOIN addresses a ON a.id = cp.address_id LEFT JOIN geofences g ON g.id = cp.geofence_id LEFT JOIN positions p ON p.id = cp.position_id\n  WHERE cp.car_id = $car_id AND cp.start_date < $__timeTo()::timestamp AND COALESCE(cp.end_date, now() AT TIME ZONE 'UTC') > $__timeFrom()::timestamp - interval '3 days'),\nseq AS (SELECT ev.*, lead(s) OVER w AS ns, lead(o0) OVER w AS no0, lead(b0) OVER w AS nb0 FROM ev WINDOW w AS (ORDER BY s)),\nrows_ AS (\n  SELECT CASE k WHEN 'drive' THEN 'Conduite' ELSE 'Recharge' END AS act, s, e, de, vers, b0, b1, km, kwh, cost, typ, k, id FROM seq\n  UNION ALL\n  SELECT CASE WHEN abs(no0 - o1) >= 1 THEN 'Données manquantes' ELSE 'Stationnement' END, e, ns, COALESCE(vers, de), NULL, b1, nb0,\n         CASE WHEN abs(no0 - o1) >= 1 THEN no0 - o1 END, NULL, NULL, NULL, 'park', NULL\n  FROM seq WHERE ns IS NOT NULL AND e IS NOT NULL AND ns > e + interval '2 minutes'\n  UNION ALL\n  SELECT 'Mise à jour', start_date, end_date, split_part(version, ' ', 1), NULL, NULL, NULL, NULL, NULL, NULL, NULL, 'update', id\n  FROM updates WHERE car_id = $car_id)\nSELECT sum(extract(epoch FROM LEAST(e, $__timeTo()::timestamp) - GREATEST(s, $__timeFrom()::timestamp))) FILTER (WHERE act = 'Conduite') AS \"Conduite\",\n  sum(extract(epoch FROM LEAST(e, $__timeTo()::timestamp) - GREATEST(s, $__timeFrom()::timestamp))) FILTER (WHERE act = 'Recharge') AS \"Recharge\",\n  sum(extract(epoch FROM LEAST(e, $__timeTo()::timestamp) - GREATEST(s, $__timeFrom()::timestamp))) FILTER (WHERE act = 'Stationnement') AS \"Stationnement\",\n  count(*) FILTER (WHERE act = 'Données manquantes') AS \"Trous\"\nFROM rows_ WHERE s < $__timeTo()::timestamp AND e > $__timeFrom()::timestamp",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Conduite$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3274D9",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
