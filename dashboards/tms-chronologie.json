        "content": "<div style=\"background-color:#37475E;border-radius:8px;padding:9px 18px;color:#fff;font-size:14px;box-shadow:0 2px 6px rgba(0,0,0,0.25);\"><b style=\"font-size:16px;letter-spacing:0.3px;\">🕒 CHRONOLOGIE</b><span style=\"color:rgba(255,255,255,0.88);\">&nbsp;&nbsp;—&nbsp;&nbsp;conduite, recharges, stationnements et mises à jour ; clique la date d'un trajet ou d'une recharge pour son détail</span></div>"
      }
