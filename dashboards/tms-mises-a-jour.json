    {
      "id": 3,
      "type": "stat",
      "title": "Version actuelle",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH u AS (SELECT start_date, version, extract(epoch FROM start_date - lag(start_date) OVER (ORDER BY start_date)) AS gap\n           FROM updates WHERE car_id = $car_id)\nSELECT (SELECT split_part(version, ' ', 1) FROM u ORDER BY start_date DESC LIMIT 1) AS \"Version\",\n  (SELECT extract(epoch FROM start_date) * 1000 FROM u ORDER BY start_date DESC LIMIT 1) AS \"Installée\",\n  (SELECT count(*) FROM u WHERE $__timeFilter(start_date)) AS \"Nombre\",\n  (SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY gap) FROM u WHERE gap IS NOT NULL) AS \"Intervalle\"",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Version$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6E7580",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
