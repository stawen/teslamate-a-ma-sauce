    {
      "id": 7,
      "type": "table",
      "title": "Versions",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH u AS (SELECT *, COALESCE(lead(start_date) OVER (ORDER BY start_date), now() AT TIME ZONE 'UTC') AS next_start,\n                  lag(start_date) OVER (ORDER BY start_date) AS prev_start FROM updates WHERE car_id = $car_id)\nSELECT u.start_date AS \"Date\", split_part(u.version, ' ', 1) AS \"Version\", extract(epoch FROM u.end_date - u.start_date) AS \"Installation\",\n  extract(epoch FROM u.start_date - u.prev_start) AS \"Depuis la précédente\",\n  (SELECT count(*) FROM charging_processes cp WHERE cp.car_id = $car_id AND cp.start_date BETWEEN u.start_date AND u.next_start) AS \"Recharges\",\n  (SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY cp.end_${preferred_range}_range_km / nullif(cp.end_battery_level, 0) * 100)\n     FROM charging_processes cp WHERE cp.car_id = $car_id AND cp.end_battery_level >= 50 AND cp.start_date BETWEEN u.start_date AND u.next_start) AS \"Autonomie à 100 %\",\n  (SELECT sum((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency) * 100 / nullif(sum(d.distance), 0) FROM drives d JOIN cars car ON car.id = d.car_id WHERE d.car_id = $car_id AND d.start_date BETWEEN u.start_date AND u.next_start) AS \"Conso roulage\"\nFROM u WHERE $__timeFilter(u.start_date) ORDER BY u.start_date DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#56A64B",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Date"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Installation"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Depuis la précédente"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Autonomie à 100 %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: km"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
