      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ev AS (\n  SELECT d.start_date AS s, d.end_date AS e, d.start_${preferred_range}_range_km AS sr, d.end_${preferred_range}_range_km AS er, d.start_km AS o0, d.end_km AS o1,\n         d.end_address_id AS addr, d.end_geofence_id AS geo\n  FROM drives d WHERE d.car_id = $car_id AND $__timeFilter(d.start_date) AND d.end_date IS NOT NULL\n  UNION ALL\n  SELECT cp.start_date, cp.end_date, cp.start_${preferred_range}_range_km, cp.end_${preferred_range}_range_km, p.odometer, p.odometer, cp.address_id, cp.geofence_id\n  FROM charging_processes cp JOIN positions p ON p.id = cp.position_id\n  WHERE cp.car_id = $car_id AND $__timeFilter(cp.start_date) AND cp.end_date IS NOT NULL),\ng AS (SELECT e AS debut, lead(s) OVER w AS fin, er AS r0, lead(sr) OVER w AS r1, o1, lead(o0) OVER w AS o_next, addr, geo\n      FROM ev WINDOW w AS (ORDER BY s)),\ngg AS (\n  SELECT g.*, extract(epoch FROM fin - debut) / 3600 AS h, (r0 - r1) * (SELECT efficiency FROM cars WHERE id = $car_id) AS kwh, r0 - r1 AS km,\n    COALESCE((SELECT sum(extract(epoch FROM LEAST(COALESCE(st.end_date, g.fin), g.fin) - GREATEST(st.start_date, g.debut)))\n              FROM states st WHERE st.car_id = $car_id AND st.state = 'asleep' AND st.start_date < g.fin AND COALESCE(st.end_date, g.fin) > g.debut), 0)\n      / nullif(extract(epoch FROM fin - debut), 0) * 100 AS dort\n  FROM g WHERE fin IS NOT NULL AND fin - debut >= interval '1 hour' * $duree AND abs(COALESCE(o_next - o1, 0)) < 1)\nSELECT debut AS \"Début\", fin AS \"Fin\", COALESCE(gf.name, CONCAT_WS(', ', COALESCE(a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), '')), COALESCE(a.city, a.neighbourhood))) AS \"Lieu\", h * 3600 AS \"Durée\", dort AS \"Endormie\", km AS \"Km perdus\", kwh AS \"kWh\",\n  kwh / nullif(h, 0) * 1000 AS \"Puissance\", km / nullif(h, 0) AS \"Km perdus / h\"\nFROM gg LEFT JOIN addresses a ON a.id = gg.addr LEFT JOIN geofences gf ON gf.id = gg.geo ORDER BY debut DESC",
          "refId": "A"
        }
